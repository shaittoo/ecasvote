# Root docker-compose (ecasvote/) — copy to .env and adjust for your server.

# Browser-visible API base (baked into frontend at docker build time).
# Must match how clients reach the gateway: direct port, or Nginx path.
# Examples:
#   http://localhost:4000
#   https://192.168.1.6/ecasvote-gateway   # if Nginx proxies /ecasvote-gateway → gateway:4000
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000

# Frontend Docker build: allow next/image for gateway-hosted candidate photos on LAN / HTTPS.
# Comma-separated. Optional scheme suffix "|http" or "|https" (default https).
# Example Debian LAN:
# NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=192.168.1.6
NEXT_PUBLIC_IMAGE_REMOTE_HOSTS=

# Optional: Next.js dev rewrites target (frontend-ecasvote/next.config.ts)
# GATEWAY_PROXY_URL=http://127.0.0.1:4000

# --- Gateway (docker-compose gateway service or bare metal) ---
# PORT=4000
# DATABASE_URL=file:./prisma/dev.db
# CHANNEL_NAME=mychannel
# CHAINCODE_NAME=ecasvote
# MSP_ID=Org1MSP
# CRYPTO_PATH=/crypto/organizations/peerOrganizations/org1.example.com
# CRYPTO_BASE_PATH=/crypto/organizations/peerOrganizations
# PEER_ENDPOINT=localhost:7051
# PEER_HOST_ALIAS=peer0.org1.example.com
# PEER_ENDPOINT_ORG2=localhost:9051
# PEER_ENDPOINT_ORG3=localhost:11051
# OMR_WORKER_URL=http://127.0.0.1:8090
# ELECTION_POSITIONS_CACHE_TTL_MS=120000

# --- OMR worker ---
# GATEWAY_URL=http://localhost:4000
# OMR_ROTATION_SHORTCUT=0
